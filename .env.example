# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_BASE_URL=https://localhost:8000
# Signs/encrypts the session cookie that holds OAuth state + PKCE verifier
SESSION_SECRET=
# Fernet key for encrypting Buffer tokens at rest
# generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=
# Days to keep a file whose post never reaches "sent"
MEDIA_TTL_DAYS=60

# --- Buffer OAuth App Client (https://publish.buffer.com/settings/api -> App Clients) ---
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Must match a registered redirect URI character for character
BUFFER_REDIRECT_URI=https://localhost:8000/callback
BUFFER_SCOPES=posts:read posts:write account:read offline_access

# --- Database: sqlite:///./dev.db for local dev, postgresql+psycopg://... for Neon/Supabase ---
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL (r2.dev subdomain or custom domain), no trailing slash
R2_PUBLIC_BASE_URL=
